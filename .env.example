# ============================================
# JARVIS Environment Variables
# ============================================
# Copy this to .env and fill in your values

# ============================================
# DATABASE - Supabase
# ============================================
# Get from: https://app.supabase.com/project/_/settings/api
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your-anon-key

# ============================================
# QUEUE - Upstash (Serverless Redis)
# ============================================
# Get from: https://console.upstash.com/redis/{database-id}
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxxxxx...

# ============================================
# LLM PROVIDERS
# ============================================
# Gemini (Simple tasks - cheapest: $0.075/1M input)
# Get from: https://console.cloud.google.com/apis/credentials
GEMINI_API_KEY=AIzaSy...your-key

# OpenAI GPT-4.1 nano (Complex tasks - $0.10/1M input)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...your-key

# ============================================
# TELEGRAM BOT
# ============================================
# Get from: @BotFather on Telegram
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklmnopQRSTuvwxyz

# ============================================
# GOOGLE CLOUD PLATFORM
# ============================================
# Project ID (from GCP Console)
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=asia-south1  # Mumbai region (closest to India)

# Cloud Run Service URLs (filled after deployment)
CLOUD_RUN_API_URL=https://jarvis-api-xxx.a.run.app
CLOUD_RUN_WORKER_URL=https://jarvis-worker-xxx.a.run.app

# Cloud Tasks Queue
CLOUD_TASKS_QUEUE=agent-queue
CLOUD_TASKS_LOCATION=asia-south1

# ============================================
# APP SETTINGS
# ============================================
APP_ENV=development
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000

# ============================================
# OPTIONAL: Web Search (Tavily)
# ============================================
TAVILY_API_KEY=